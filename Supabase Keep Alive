name: Supabase Keep Alive

on:
  schedule:
    - cron: '0 0 */3 * *'  # Corre cada 3 días a medianoche UTC
  workflow_dispatch:        # Permite ejecutarlo manualmente también

jobs:
  keep-alive:
    runs-on: ubuntu-latest
    steps:
      - name: Ping Supabase
        run: |
          STATUS=$(curl -s -o /dev/null -w "%{http_code}" \
            "https://pskfhdscxuauqxsmfrjm.supabase.co/health")
          echo "Supabase status: $STATUS"
